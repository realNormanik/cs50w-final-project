{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leadflow",
  "main": "src/index.py",
  "compatibility_flags": [
    "python_workers"
  ],
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": "./staticfiles",
    "binding": "ASSETS"
  },
  "build": {
    "command": "WORKERS_CI=1 python src/manage.py collectstatic --noinput"
  },
  "python_modules": {
    "exclude": [
      "**/*.pyc",
      "**/__pycache__",
      "**/*.po",
      "**/*.css",
      "**/*.js",
      "**/*.svg",
      "**/*.png",
      "**/*.jpg"
    ]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cs50",
      "database_id": "e7af7a4f-4f32-4aaa-9fe3-33db3653c0b7"
    }
  ]
}
